/dist/
# Lokale Maschinen-Overrides gehören nie ins Repo
unreagent.local.yaml
unreagent.local.yml
# vendor/ wird bewusst committed (offline-reproduzierbare Builds)

# Code-Signing: privater Schluessel NIEMALS ins Repo
signing/*.key
signing/*.pfx

# karr materialized task view -- never commit
tasks/
config.yml

# Per-machine Claude Code permissions/MCP selection -- never commit
.claude/settings.local.json

# run_python/run_node script files left behind by a hard kill; the digit prefix
# keeps hand-written files like unreagent-helper.py out of the pattern
unreagent-[0-9]*.py
unreagent-[0-9]*.mjs
