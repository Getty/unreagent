# Write ownership for unreagent: one <path><TAB><owner> row per rule.
# An exact path wins, otherwise the longest directory prefix (ending in /).
# Every path has an owner; there is no fallback. Resolve with: ack-team owner <file>
#
# Tests (*_test.go) sit next to the code they test, inside the worker's paths;
# unreagent-test-writer writes them there when a card's step is a test.

# Go code, demo, build, CI and release plumbing
cmd/	unreagent-worker
internal/	unreagent-worker
example/	unreagent-worker
scripts/	unreagent-worker
signing/	unreagent-worker
assets/	unreagent-worker
vendor/	unreagent-worker
.github/	unreagent-worker
Makefile	unreagent-worker
go.mod	unreagent-worker
go.sum	unreagent-worker
.gitattributes	unreagent-worker

# Shipped UE skills and the parser that embeds them (serving and materializing them is
# launcher wiring in cmd/launcher/skills.go, owned by unreagent-worker)
skills/	unreagent-skill-author
internal/skills/	unreagent-skill-author

# Project skills the agent team is briefed with
.claude/skills/unreagent-core/	unreagent-skill-author
.claude/skills/unreagent-config/	unreagent-skill-author
.claude/skills/unreagent-mcp-tools/	unreagent-skill-author
.claude/skills/unreagent-windows/	unreagent-skill-author
.claude/skills/unreagent-skill-authoring/	unreagent-skill-author

# User-facing documentation
README.md	unreagent-doc-writer
example/README.md	unreagent-doc-writer
unreagent.example.yaml	unreagent-doc-writer
docs/	unreagent-doc-writer
NOTICE	unreagent-doc-writer

# History
Changes	unreagent-release-manager

# Team setup (skilletor-installed skills and rules under .claude/ are never hand-edited)
.claude/	main
CLAUDE.md	main
OWNERS	main
.gitignore	main
.worktreeinclude	main
